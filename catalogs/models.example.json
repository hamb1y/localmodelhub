{
  "schema_version": 1,
  "runtimes": {
    "container-llama": {
      "adapter": "llama.cpp",
      "image": "ghcr.io/ggml-org/llama.cpp:server@sha256:b0cd5490eefff30b40dcd47f7249a7d7211136908f73fe440a2a86b35a22b23b"
    }
  },
  "artifacts": {
    "local-weights": {
      "source": {
        "kind": "local",
        "path": "/absolute/path/to/model.gguf"
      }
    },
    "hf-weights": {
      "source": {
        "kind": "hf",
        "repo": "example-org/replace-with-model-repo",
        "revision": "0123456789abcdef0123456789abcdef01234567",
        "file": "replace-with-model.gguf"
      }
    }
  },
  "models": {
    "example-model": {
      "name": "Example model (replace placeholder paths and commit)",
      "io": [{"input": ["text"], "output": "text"}],
      "default_profile": "local-cpu",
      "profiles": {
        "local-cpu": {
          "runtime": "container-llama",
          "device": "cpu",
          "artifacts": { "model": "local-weights" }
        },
        "hf-cpu": {
          "runtime": "container-llama",
          "device": "cpu",
          "artifacts": { "model": "hf-weights" }
        }
      }
    }
  },
  "boot": []
}
