{
  "extends": "$app/tsconfig",
  "include": ["src", "tests", "vite.config.ts"],
  "exclude": ["src/service-worker"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["$app/types", "bun"],
    "paths": { "$lib/*": ["./src/lib/*"] }
  }
}
